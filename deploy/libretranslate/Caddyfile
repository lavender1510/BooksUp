{
  # Caddy obtains/renews HTTPS certificates when the public DNS record is valid.
}

{$TRANSLATE_DOMAIN} {
  @translation_api {
    path /translate /languages
  }

  handle @translation_api {
    request_body {
      max_size 24KB
    }
    reverse_proxy libretranslate:5000
  }

  handle {
    respond "Not found" 404
  }
}
