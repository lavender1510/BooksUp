{
  "name": "booksup",
  "version": "4.5.0",
  "private": true,
  "description": "BooksUp 4.5: reading lists, separate library, local automatic backups and desktop analytics",
  "productName": "BooksUp",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "desktop:windows": "electron-builder --win nsis portable --publish never",
    "desktop:linux": "electron-builder --linux AppImage",
    "desktop:mac": "electron-builder --mac dmg",
    "android:init": "node tools/android-init.cjs",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node tools/build-apk.cjs",
    "test:static": "node tools/check-project.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.0",
    "electron-updater": "^6.6.2",
    "@capgo/capacitor-social-login": "^8.5.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.lyvt.booksup",
    "productName": "BooksUp",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "build/icon.png",
      "package.json",
      "!**/.DS_Store"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lavender1510",
        "repo": "BooksUp",
        "releaseType": "prerelease"
      }
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
